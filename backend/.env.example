# AlertIQ Backend configuration — copy to .env and fill in real values.
# NEVER commit a real .env or real API keys.

# --- Core ---
DATABASE_URL=sqlite:///./alertiq.db
SECRET_KEY=generate-a-long-random-string-here
# Optional dedicated Fernet key for credential encryption (base64, 32 bytes).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,capacitor://localhost,http://localhost,https://localhost

# Seeds clearly-labeled demo data into an EMPTY database only (never touches real data).
DEMO_MODE=false

# --- Auth ---
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- LLM provider: none | openai | anthropic | gemini ---
# "none" = local rule-based analysis engine (honest fallback, no LLM calls)
LLM_PROVIDER=none
LLM_API_KEY=
# Optional model override (e.g. gpt-4o-mini, claude-sonnet-4-20250514, gemini-2.0-flash)
LLM_MODEL=
# Optional OpenAI-compatible endpoint override (e.g. a self-hosted vLLM/LiteLLM server)
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=45

# --- Web research: none | tavily | serper ---
SEARCH_PROVIDER=none
SEARCH_API_KEY=

# --- Analysis tuning ---
CORRELATION_WINDOW_MINUTES=30
ANOMALY_IFOREST_MIN_SAMPLES=50
ANOMALY_SCAN_HISTORY_DAYS=14
RATE_LIMIT_PER_MINUTE=60
